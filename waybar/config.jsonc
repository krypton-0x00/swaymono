{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 10,
  "margin-left": 14,
  "margin-right": 14,
  "spacing": 0,

  "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "battery", "tray"],


  "sway/workspaces": {
    "format": "{index}",
    "disable-scroll": true,
    "all-outputs": false,
    // Workspaces are named "<number>:<output>" so each monitor has its own 1-10.
    // These entries keep all ten buttons visible on the matching output.
    // If an output name changes (see: swaymsg -t get_outputs), update it here.
    "persistent-workspaces": {
      "1:eDP-1": ["eDP-1"],
      "2:eDP-1": ["eDP-1"],
      "3:eDP-1": ["eDP-1"],
      "4:eDP-1": ["eDP-1"],
      "5:eDP-1": ["eDP-1"],
      "6:eDP-1": ["eDP-1"],
      "7:eDP-1": ["eDP-1"],
      "8:eDP-1": ["eDP-1"],
      "9:eDP-1": ["eDP-1"],
      "10:eDP-1": ["eDP-1"],

      "1:HDMI-A-2": ["HDMI-A-2"],
      "2:HDMI-A-2": ["HDMI-A-2"],
      "3:HDMI-A-2": ["HDMI-A-2"],
      "4:HDMI-A-2": ["HDMI-A-2"],
      "5:HDMI-A-2": ["HDMI-A-2"],
      "6:HDMI-A-2": ["HDMI-A-2"],
      "7:HDMI-A-2": ["HDMI-A-2"],
      "8:HDMI-A-2": ["HDMI-A-2"],
      "9:HDMI-A-2": ["HDMI-A-2"],
      "10:HDMI-A-2": ["HDMI-A-2"]
    }
  },
    "sway/mode": {
    "format": "{}"
  },

  "sway/window": {
    "format": "{title}",
    "max-length": 40
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b %Y}",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "VOL {volume}",
    "format-muted": "VOL --",
    "on-click": "pavucontrol",
    "tooltip": false
  },

  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "ETH",
    "format-disconnected": "OFFLINE",
    "tooltip": false
  },

  "cpu": {
    "format": "CPU {usage}",
    "interval": 3,
    "tooltip": false
  },

  "memory": {
    "format": "MEM {percentage}",
    "interval": 5,
    "tooltip": false
  },

  "battery": {
    "format": "BAT {capacity}",
    "format-charging": "BAT {capacity}+",
    "states": { "warning": 20, "critical": 10 },
    "tooltip": false
  },

  "tray": {
    "spacing": 10
  }
}
