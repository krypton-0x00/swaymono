# Monochrome, square, floating
font=JetBrains Mono 10
background-color=#0a0a0aee
text-color=#e6e6e6
border-color=#3a3a3a
border-size=1
border-radius=0
padding=12
margin=10,14
width=340
height=120
icons=0
anchor=top-right
layer=overlay
default-timeout=5000
ignore-timeout=0
max-visible=4
sort=-time
format=<b>%s</b>\n%b
markup=1

[urgency=low]
text-color=#8a8a8a
border-color=#1f1f1f
default-timeout=3000

[urgency=critical]
background-color=#e6e6e6
text-color=#0a0a0a
border-color=#e6e6e6
default-timeout=0

[mode=do-not-disturb]
invisible=1
